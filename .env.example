# Public URL of the app, used for absolute links and Open Graph metadata
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SerpApi Google Flights — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Uncomment to use bundled demo flights in development (saves API quota)
# SERPAPI_USE_FIXTURES=true

# PostHog analytics (requests are proxied through /ingest, see next.config.ts)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
